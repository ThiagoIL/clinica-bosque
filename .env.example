# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bosque"

# Segredo usado para assinar a sessão. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Usuário administrador criado automaticamente no primeiro start (se não existir nenhum usuário)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@bosque.local"
ADMIN_PASSWORD="troque-esta-senha"

# Console de administração do fornecedor (bloqueio do sistema e módulos liberados).
# Domínio(s), separados por vírgula, que abrem o console em vez do sistema da clínica.
# Aponte o domínio para este mesmo serviço (ex.: admin.bosque.tipmp.com.br).
PLATFORM_ADMIN_HOSTS="admin.bosque.tipmp.com.br"
PLATFORM_ADMIN_NAME="Fornecedor"
PLATFORM_ADMIN_EMAIL="fornecedor@exemplo.com.br"
PLATFORM_ADMIN_PASSWORD="troque-esta-senha-longa"

# Fuso horário da clínica
TZ="America/Sao_Paulo"
